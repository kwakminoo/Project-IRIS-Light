# =============================================================================
# Iris Light — 환경 변수 템플릿
# =============================================================================
# 사용법:
#   1) 이 파일을 복사해 프로젝트 루트에 `.env` 생성
#        copy .env.example .env
#   2) 아래 IRIS_* 값을 필요 시 수정 (Iris가 직접 읽음)
#   3) 「Hermes로 옮길 키」주석 블록의 KEY=value 를
#      %LOCALAPPDATA%\hermes\.env 에 붙여넣기 (웹검색·API Server용)
#   4) README.md 의 설치·검증 절차 진행
#
# 주의: `.env` 는 gitignore 됨. `.env.example` 만 저장소에 올라감.
# 아래 Hermes 키 주석은 정상 동작하던 머신의 스냅샷 참고값이다.
# 공개 저장소라면 본인 키로 교체·로테이션을 권장한다.
# =============================================================================

# --- Iris runtime (Iris가 load_dotenv 로 읽음) ---
IRIS_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
IRIS_OLLAMA_MODEL=gemma4-26b:latest
IRIS_HERMES_ENABLED=1
IRIS_HERMES_BASE_URL=http://127.0.0.1:8642/v1
IRIS_HERMES_COMMAND=hermes
# Hermes config.yaml platforms.api_server.extra.key 와 동일해야 함
IRIS_HERMES_API_KEY=change-me-local-dev

# --- 선택: Iris Control Surface (기본값으로도 동작) ---
# IRIS_CONTROL_ENABLED=1
# IRIS_CONTROL_HOST=127.0.0.1
# IRIS_CONTROL_PORT=8765

# =============================================================================
# Hermes로 옮길 키 (주석 = 참고 스냅샷)
# Iris는 이 블록을 읽지 않는다. 아래 줄의 `# ` 만 제거한 뒤
# %LOCALAPPDATA%\hermes\.env 에 넣거나, README의 복사 스크립트를 실행한다.
# =============================================================================

# --- API Server (Iris ↔ Hermes :8642) ---
# API_SERVER_ENABLED=true
# API_SERVER_KEY=change-me-local-dev

# --- 웹검색 / 추출 (Hermes tools) ---
# SERPAPI_API_KEY=6ce75ba0fbdb32040229189aa61cee1cb490c43dbc90d3fb4ebaaa3c01ac90dc
# SERPAPI_DEFAULT_ENGINE=google
# EXA_API_KEY=cb0521fd-7008-4866-9d21-fc701529088e
# FIRECRAWL_API_KEY=xc-wLLdOvA7FmsS0QsAFyzvDKXXWL0Wao0Luflts44xeOBFc0Ak

# --- 기타 (선택, 네이버 등) ---
# NAVER_CLIENT_ID=v2LtwsZ7LElWewD_rG5Q
# NAVER_CLIENT_SECRET=wVLHuv3rJq

# --- 터미널 / 브라우저 기본값 (Hermes 스냅샷) ---
# TERMINAL_MODAL_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20
# TERMINAL_TIMEOUT=60
# TERMINAL_LIFETIME_SECONDS=300
# BROWSERBASE_PROXIES=true
# BROWSERBASE_ADVANCED_STEALTH=false
# BROWSER_SESSION_TIMEOUT=300
# BROWSER_INACTIVITY_TIMEOUT=120
# WEB_TOOLS_DEBUG=false
# VISION_TOOLS_DEBUG=false
# MOA_TOOLS_DEBUG=false
# IMAGE_TOOLS_DEBUG=false
