# Iris Light 환경 설정 예시. setup 스크립트가 이 파일을 .env로 복사합니다.
# 비밀 키는 이 파일에 넣거나 커밋하지 마세요. 첫 실행 위저드에서 설정할 수 있습니다.

# Ollama 로컬 서버 및 기본 모델
IRIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
IRIS_OLLAMA_MODEL=

# Iris Agent 설정. 실행 파일과 API 키는 시작 위저드가 준비합니다.
IRIS_AGENT_ENABLED=1
IRIS_AGENT_BASE_URL=http://127.0.0.1:8642/v1
IRIS_AGENT_COMMAND=
IRIS_AGENT_API_KEY=

# 선택: Iris Control Surface (기본 :8765)
# IRIS_CONTROL_ENABLED=1
# IRIS_CONTROL_HOST=127.0.0.1
# IRIS_CONTROL_PORT=8765
# IRIS_CONTROL_TOKEN=

# 선택: 캘린더 공휴일 (data.go.kr)
# IRIS_DATA_GO_KR_SERVICE_KEY=

# 선택: 시작 프로토콜과 음성 런타임
# IRIS_SETUP_DEMO=0
# IRIS_SETUP_DRY_RUN=0
# VOICE_RUNTIME_MOCK=0

# 아래 선택 키는 Iris Agent 홈의 .env에 설정합니다.
# 기본 위치: ~/.iris-light/agent/.env (IRIS_AGENT_HOME 설정 시 해당 경로의 .env)
# API_SERVER_ENABLED=true
# API_SERVER_KEY=
# SERPAPI_API_KEY=
# SERPAPI_DEFAULT_ENGINE=google
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
