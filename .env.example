# =====================================================
# Iris Light — 환경 설정 템플릿
#
# setup.bat / setup.ps1 / setup.sh 가 이 파일을 .env 로 복사합니다.
# .env 는 .gitignore 에 있어 커밋되지 않습니다. 절대 키를 커밋하지 마세요.
#
# 아래 값은 전부 비워 두어도 됩니다.
# 첫 실행 시 뜨는 [시작 위저드]가 Ollama·Hermes 설치와 키 입력을 안내합니다.
# =====================================================

# --- Iris runtime ---
# Ollama 로컬 서버 주소 (기본값 그대로 두면 됩니다)
IRIS_OLLAMA_BASE_URL=http://127.0.0.1:11434

# 기본 모델. 비워 두면 앱에서 선택합니다.
# 로컬 예: qwen3:4b / gemma3:4b   클라우드 예: gpt-oss:120b-cloud
IRIS_OLLAMA_MODEL=

# --- Hermes Agent (도구·스킬 실행 게이트웨이) ---
IRIS_HERMES_ENABLED=1
IRIS_HERMES_BASE_URL=http://127.0.0.1:8642
# 비워 두면 시작 위저드가 설치 경로를 찾아 채웁니다.
IRIS_HERMES_COMMAND=
# 게이트웨이 API 키. 위저드가 생성/연결합니다.
IRIS_HERMES_API_KEY=

# --- 선택: Control Surface (Hermes → Iris UI 역제어, 기본 :8765) ---
# IRIS_CONTROL_ENABLED=1
# IRIS_CONTROL_HOST=127.0.0.1
# IRIS_CONTROL_PORT=8765
# IRIS_CONTROL_TOKEN=

# --- 선택: 캘린더 공휴일 (data.go.kr) ---
# IRIS_DATA_GO_KR_SERVICE_KEY=

# --- 선택: 시작 프로토콜 ---
# IRIS_SETUP_DEMO=0
# IRIS_SETUP_DRY_RUN=0

# --- 선택: 음성 런타임 (.venv-voice, 기본 포트 18765) ---
# VOICE_RUNTIME_MOCK=0

# =====================================================
# 아래는 Hermes 쪽 .env 로 옮겨야 하는 키들입니다 (Iris 는 읽지 않음).
# 대상 파일: %LOCALAPPDATA%\hermes\.env
# scripts\apply_env_to_hermes.ps1 로 옮길 수 있습니다.
# 웹검색 등 선택 기능을 쓸 때만 필요합니다.
# =====================================================

# API_SERVER_ENABLED=true
# API_SERVER_KEY=
# SERPAPI_API_KEY=
# SERPAPI_DEFAULT_ENGINE=google
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
