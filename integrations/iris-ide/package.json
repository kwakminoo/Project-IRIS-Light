{
  "private": true,
  "name": "iris-ide",
  "version": "1.0.0",
  "description": "IRIS IDE — Eclipse Theia browser application",
  "license": "EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0",
  "engines": {
    "node": ">=22"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/iris-ide-frontend-module",
      "backend": "lib/node/iris-ide-backend-module"
    }
  ],
  "dependencies": {
    "@theia/bulk-edit": "1.74.0",
    "@theia/callhierarchy": "1.74.0",
    "@theia/cli": "1.74.0",
    "@theia/core": "1.74.0",
    "@theia/debug": "1.74.0",
    "@theia/editor": "1.74.0",
    "@theia/filesystem": "1.74.0",
    "@theia/markers": "1.74.0",
    "@theia/monaco": "1.74.0",
    "@theia/navigator": "1.74.0",
    "@theia/outline-view": "1.74.0",
    "@theia/output": "1.74.0",
    "@theia/plugin-ext": "1.74.0",
    "@theia/plugin-ext-vscode": "1.74.0",
    "@theia/preferences": "1.74.0",
    "@theia/process": "1.74.0",
    "@theia/property-view": "1.74.0",
    "@theia/scm": "1.74.0",
    "@theia/scm-extra": "1.74.0",
    "@theia/search-in-workspace": "1.74.0",
    "@theia/task": "1.74.0",
    "@theia/terminal": "1.74.0",
    "@theia/typehierarchy": "1.74.0",
    "@theia/userstorage": "1.74.0",
    "@theia/variable-resolver": "1.74.0",
    "@theia/vsx-registry": "1.74.0",
    "@theia/workspace": "1.74.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "~5.4.5"
  },
  "scripts": {
    "postinstall": "node scripts/stub-windows-ca-certs.js",
    "download:plugins": "theia download:plugins",
    "prebuild": "theia download:plugins",
    "build": "theia build --mode development && node scripts/patch-theia-build.js",
    "rebuild": "theia rebuild:browser --cacheRoot .theia",
    "start": "theia start --hostname=127.0.0.1 --plugins=local-dir:./plugins --ovsx-router-config=ovsx-router-config.json",
    "watch": "theia build --watch --mode development"
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode-builtin-extensions": "https://github.com/eclipse-theia/vscode-builtin-extensions/releases/download/1.108.2/vscode-builtin-extensions-1.108.2.tar.gz"
  },
  "theiaPluginsExcludeIds": [
    "ms-vscode.js-debug-companion",
    "vscode.extension-editing",
    "vscode.github",
    "vscode.github-authentication",
    "vscode.microsoft-authentication"
  ],
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "IRIS IDE",
        "defaultTheme": "dark",
        "defaultIconTheme": "theia-file-icons",
        "preferences": {
          "extensions.ignoreRecommendations": false,
          "security.workspace.trust.enabled": false
        }
      }
    }
  }
}
