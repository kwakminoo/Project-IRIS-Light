dist/IRIS.exe filter=lfs diff=lfs merge=lfs -text
android-emulator/avd/**/*.qcow2 filter=lfs diff=lfs merge=lfs -text
android-emulator/avd/**/*.img filter=lfs diff=lfs merge=lfs -text

# 셸 스크립트는 항상 LF (Windows에서 clone 해도 Linux/macOS에서 실행 가능)
*.sh text eol=lf
# 배치 파일은 항상 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
